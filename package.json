{
  "name": "btc-float",
  "productName": "BTC Float",
  "version": "0.1.0",
  "description": "A lightweight Windows desktop widget for live BTC futures prices.",
  "author": "startBoom",
  "private": true,
  "main": "out/main/index.js",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "predev": "install-electron",
    "dev": "electron-vite dev --watch",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && vue-tsc --noEmit -p tsconfig.web.json",
    "build": "npm run typecheck && electron-vite build",
    "start": "electron .",
    "dist:win": "npm run build && electron-builder --win --x64 --publish never"
  },
  "dependencies": {
    "lightweight-charts": "^5.3.0",
    "vue": "^3.5.0"
  },
  "devDependencies": {
    "@types/node": "^22.12.0",
    "@vitejs/plugin-vue": "^6.0.0",
    "electron": "^45.4.1",
    "electron-builder": "26.18.1",
    "electron-vite": "^5.0.0",
    "typescript": "~5.9.3",
    "vite": "^7.0.0",
    "vue-tsc": "^3.0.0"
  }
}
